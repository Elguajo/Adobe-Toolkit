{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Elguajo/Adobe-Toolkit/blob/main/shared/cleaner-manifest.schema.json",
  "title": "Adobe Environment Toolkit cleaner manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "macos", "windows"],
  "properties": {
    "version": { "const": 1 },
    "macos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_patterns", "paths_remove"],
      "properties": {
        "kill_patterns": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "paths_remove": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes", "services", "paths_remove"],
      "properties": {
        "processes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "services": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "paths_remove": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "uniqueItems": true
    }
  }
}
